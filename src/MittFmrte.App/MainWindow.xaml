<Window x:Class="MittFmrte.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MittFMRTE" Height="820" Width="1280" MinHeight="600" MinWidth="980"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBg}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="MittFMRTE" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <Grid DockPanel.Dock="Left" Width="320" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             IsEnabled="False" ToolTip="Sök spelare (minst 3 bokstäver)" />
                    <TextBlock Text="Sök spelare..." Foreground="{StaticResource TextDim}" Margin="8,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" x:Name="SearchHint" />
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                           StaysOpen="False" Width="420" AllowsTransparency="True">
                        <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ListBox x:Name="SearchResults" MaxHeight="420" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" ItemContainerStyle="{StaticResource DarkListItem}" MouseUp="SearchResults_MouseUp" KeyDown="SearchResults_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Name}" Width="200" />
                                            <TextBlock Text="{Binding Club}" Foreground="{StaticResource TextDim}" Width="140" />
                                            <TextBlock Text="{Binding Ability}" Foreground="{StaticResource TextDim}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Ladda sparfil"
                        Click="LoadSave_Click" Margin="8,0,0,0" x:Name="LoadButton" />
                <Button DockPanel.Dock="Right" Content="Ångra senaste" Click="Undo_Click" x:Name="UndoButton"
                        IsEnabled="False" Margin="8,0,0,0" ToolTip="Ångrar den senaste preseten" />
            </DockPanel>
        </Border>

        <!-- Orange header, like FMRTE -->
        <Border Grid.Row="1" Background="{StaticResource Accent}" Padding="16,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="Ladda din sparfil" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="HeaderSubtitle" Text="Välj en FM24-sparfil (.fm) för att börja" FontSize="15"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Nav" Grid.Column="0" Background="{StaticResource WindowBg}" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                     IsEnabled="False" Padding="0,8,0,0">
                <ListBoxItem Tag="squad">Trupp</ListBoxItem>
                <ListBoxItem Tag="player">Spelare</ListBoxItem>
                <ListBoxItem Tag="signings">Smarta värvningar</ListBoxItem>
            </ListBox>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="8" />

            <!-- Shown until a save is loaded -->
            <Border x:Name="Welcome" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource WindowBg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="Välkommen till MittFMRTE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,12,0,20">
                        Ladda en sparfil från Football Manager 2024. Allt du ser kommer från din sparfil.
                        Sparfilerna ligger oftast i Dokument\Sports Interactive\Football Manager 2024\games.
                    </TextBlock>
                    <Button Style="{StaticResource AccentButton}" Content="Ladda sparfil" Click="LoadSave_Click"
                            HorizontalAlignment="Center" FontSize="15" Padding="28,10" x:Name="WelcomeLoadButton" />
                    <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource TopBarBg}" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="StatusRight" Foreground="{StaticResource TextDim}" />
                <TextBlock x:Name="StatusLeft" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
