<UserControl x:Class="MittFmrte.App.Views.SquadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <TextBlock Text="Klubb:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ClubPicker" Width="320" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      DisplayMemberPath="Name" SelectionChanged="ClubPicker_SelectionChanged" HorizontalAlignment="Left" />
            <TextBlock x:Name="SquadInfo" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextDim}" />
        </DockPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" MouseDoubleClick="Grid_MouseDoubleClick"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Namn" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Positioner" Binding="{Binding PositionText}" Width="1.6*" />
                <DataGridTextColumn Header="Ålder" Binding="{Binding Converter={StaticResource Age}}" Width="55" SortMemberPath="BirthDate" />
                <DataGridTextColumn Header="CA" Binding="{Binding CurrentAbility}" Width="50" />
                <DataGridTextColumn Header="PA" Binding="{Binding PotentialAbility}" Width="50" />
                <DataGridTextColumn Header="Rykte" Binding="{Binding Reputation}" Width="65" />
                <DataGridTextColumn Header="Värde" Binding="{Binding Value, Converter={StaticResource Money}}" Width="80" SortMemberPath="Value" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
            <HeaderedContentControl Header="Presets" Style="{StaticResource Panel}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="TargetInfo" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,2,0,8" />
                    <ItemsControl x:Name="PresetButtons">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" ToolTip="{Binding Description}" Click="Preset_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Inställningar" Style="{StaticResource Panel}" Margin="0,0,0,8">
                <CheckBox x:Name="ApplyToAll" Content="Gäller hela truppen" Checked="ApplyToAll_Changed" Unchecked="ApplyToAll_Changed" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="Tips" Style="{StaticResource Panel}" Margin="0">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                           Text="Markera en eller flera spelare (Ctrl/Shift) och klicka på en preset. Dubbelklicka för att öppna spelaren. Ångra med knappen uppe till höger." />
            </HeaderedContentControl>
        </StackPanel>
    </Grid>
</UserControl>
